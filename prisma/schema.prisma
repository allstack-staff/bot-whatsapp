datasource db {
    provider = "sqlite"
}

generator client {
    provider = "prisma-client-js"
}

model AdminGroup {
    id           String   @id // group JID
    communityJid String?  // linkedParent do grupo, detectado quando $home rodou (se o grupo for de uma Community)
    createdAt    DateTime @default(now())
}

// ID curto e estável por grupo da comunidade — pra referenciar um grupo (ex: em
// $responsavel) sem precisar colar o JID inteiro nem estar dentro do grupo.
// Populado/atualizado pelo comando $grupos.
model CommunityGroup {
    shortId   Int      @id @default(autoincrement())
    groupJid  String   @unique
    subject   String?
    updatedAt DateTime @updatedAt
}

model BannedUser {
    userJid     String   // user JID
    displayName String?  // nome público (notify) da pessoa no momento do ban, se disponível
    groupJid    String   // group where ban was issued (or "comunidade")
    banType     String   // PERMANENTE | TEMPORARIO | COMUNIDADE
    reason      String
    expiresAt   DateTime? // for TEMPORARIO — null = never expires
    bannedBy    String   // admin JID who issued the ban
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@id([userJid, groupJid])
    @@index([userJid])
    @@index([groupJid])
}

model Warning {
    id        String   @id @default(cuid())
    userJid   String
    groupJid  String
    reason    String
    issuedBy  String   // admin JID, ou "ai" quando aplicada pela moderação automática
    createdAt DateTime @default(now())

    @@index([userJid])
    @@index([groupJid])
}

// Qual admin é responsável por qual grupo (avisos de promoção, pendências como pedido de entrada)
model AdminResponsibility {
    adminJid   String
    groupJid   String
    assignedAt DateTime @default(now())

    @@id([adminJid, groupJid])
    @@index([groupJid])
}

model GroupDescriptionChange {
    id             String    @id @default(cuid())
    groupJid       String
    oldDescription String?
    newDescription String?
    proposedBy     String
    status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
    voteMessageId  String?   // key.id da mensagem de votação, pra casar com as reações
    voteGroupJid   String?   // grupo onde a votação foi postada (grupo de admins)
    createdAt      DateTime  @default(now())
    resolvedAt     DateTime?

    @@index([groupJid])
    @@index([voteMessageId])
}

// Se uma proposta de mudança de descrição é rejeitada pela maioria, o grupo fica
// travado (o bot restaura a versão anterior) por um tempo.
model GroupDescriptionLock {
    groupJid          String   @id
    lockedUntil       DateTime
    frozenDescription String?  // descrição que o bot restaura se um admin tentar mudar durante a trava
}

// Contagem simples de mensagens por pessoa por grupo — dá à moderação por IA
// um sinal real de participação sem depender de "memória" da IA (é só um
// contador nosso, incrementado a cada mensagem real). Baixa contagem +
// divulgação é agravante conforme docs/regras.md (regra 0).
model MemberActivity {
    userJid      String
    groupJid     String
    messageCount Int      @default(0)
    updatedAt    DateTime @updatedAt

    @@id([userJid, groupJid])
}

// Quantas vezes essa pessoa já foi punida automaticamente por acúmulo de
// advertências nesse grupo — usado pra escalonar: 1ª = temporário 7 dias,
// 2ª = temporário 30 dias, 3ª+ = permanente (com aviso pros admins avaliarem
// se deve virar banimento de comunidade).
model WarningPunishmentHistory {
    userJid   String
    groupJid  String
    count     Int      @default(0)
    updatedAt DateTime @updatedAt

    @@id([userJid, groupJid])
}

// Toda punição automática (moderação por IA, ou acúmulo de advertências)
// avisada no grupo de admins com opção de desfazer — por reação ❌ (sem
// motivo) ou por reply com texto (motivo registrado). Desfazer sempre
// remove o banimento e tenta readicionar a pessoa ao grupo.
model AutomatedPunishment {
    id         String    @id @default(cuid())
    userJid    String
    groupJid   String
    banType    String    // PERMANENTE | TEMPORARIO | COMUNIDADE
    reason     String
    source     String    // ia | advertencias
    messageId  String?   // key.id da notificação no grupo de admins
    status     String    @default("ACTIVE") // ACTIVE | REVERTED
    revertedBy String?
    revertReason String?
    createdAt  DateTime  @default(now())
    resolvedAt DateTime?

    @@index([messageId])
}

// Proposta de nova regra da comunidade, redigida pela IA a partir da ideia
// crua de um admin ($asb propor) e votada só por admins de comunidade
// (admin do próprio grupo de administração — ver isAdminOfAdminGroup).
// Aprovada, o bot publica direto em docs/regras.md via API do GitHub.
model RuleProposal {
    id            String    @id @default(cuid())
    proposedBy    String
    rawIdea       String
    draftedText   String
    punishment    String    // ADVERTENCIA | BANIMENTO
    conflictNote  String?
    status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | PUBLISH_FAILED
    voteMessageId String?
    createdAt     DateTime  @default(now())
    resolvedAt    DateTime?

    @@index([voteMessageId])
}

// Linha única (id sempre 1) que guarda quando a última dica mensal foi
// mandada pro grupo de admins — ver MonthlyTipService.
model MonthlyTipState {
    id         Int       @id @default(1)
    lastSentAt DateTime?
}

// Fila de mensagens ainda não avaliadas pela moderação por IA — persistida
// (não só em memória) pra sobreviver a um restart/deploy do bot sem perder o
// que ainda não foi checado. Só guarda 24h sempre: mensagem mais velha que
// isso é ignorada e limpa, nunca avaliada fora de hora.
model PendingModerationMessage {
    id             String   @id @default(cuid())
    groupJid       String
    sender         String
    text           String
    messageKeyJson String? // WAMessageKey serializado — permite apagar a mensagem se ela virar um banimento
    createdAt      DateTime @default(now())

    @@index([groupJid])
    @@index([createdAt])
}

// Ação administrativa de um admin comum (ban/advertir manual, remover,
// promover, rebaixar, rejeitar pedido de entrada) — avisada no grupo de
// admins pra um admin de comunidade revisar. Reverter/decidir aqui SEMPRE
// exige motivo em texto (não aceita reação sozinha, diferente de
// AutomatedPunishment), porque é esse texto que a IA avalia como embasado
// ou não nas regras (ver GroundingService) antes de aplicar de verdade.
// status: ACTIVE (em vigor, sem revisão ainda) | REVERTED (admin de
// comunidade reverteu, embasado) | RATIFIED (decisão do admin de comunidade
// confirmada pela maioria dos outros) | OVERTURNED (maioria derrubou a
// decisão do admin de comunidade — volta ao estado anterior).
model AdminAction {
    id            String    @id @default(cuid())
    actorJid      String // quem fez a ação original (admin comum, ou o sistema pra eventos nativos)
    actionType    String // ban | advertir | remove | promote | demote | join_reject
    groupJid      String
    targetJid     String?
    description   String // texto pronto pra mostrar no aviso, ex: "baniu @X (temporario)"
    beforeState   String? // JSON — estado anterior, quando dá pra restaurar (ex: era admin antes)
    status        String    @default("ACTIVE")
    revertedBy    String? // admin de comunidade que reverteu (decisão monocrática) — excluído da própria ratificação
    noticeMessageId String? // aviso original no grupo de admins — reply com motivo aqui = tentativa de reverter
    voteMessageId String? // mensagem de ratificação da decisão do admin de comunidade, quando houver
    createdAt     DateTime  @default(now())
    resolvedAt    DateTime?

    @@index([noticeMessageId])
    @@index([voteMessageId])
    @@index([groupJid])
}

// Banimento de comunidade proposto pela IA numa categoria que depende de
// julgamento de contexto (ver CONTEXT_DEPENDENT_CATEGORY em
// aiModerationService.ts) — não executa sozinho, só propõe. Um admin do
// grupo de admins confirma (✅ bane de verdade) ou dispensa (❌).
model PendingAiBanConfirmation {
    id              String    @id @default(cuid())
    userJid         String
    senderRaw       String
    groupJid        String
    reason          String
    category        String
    displayName     String?
    voteMessageId   String?
    messageKeysJson String? // WAMessageKey[] serializado — só apaga se confirmado
    status          String    @default("PENDING") // PENDING | CONFIRMED | DISMISSED
    createdAt       DateTime  @default(now())
    resolvedAt      DateTime?

    @@index([voteMessageId])
}
