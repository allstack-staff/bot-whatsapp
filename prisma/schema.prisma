datasource db {
    provider = "sqlite"
}

generator client {
    provider = "prisma-client-js"
}

model AdminGroup {
    id           String   @id // group JID
    communityJid String?  // linkedParent do grupo, detectado quando $home rodou (se o grupo for de uma Community)
    createdAt    DateTime @default(now())
}

// ID curto e estável por grupo da comunidade — pra referenciar um grupo (ex: em
// $responsavel) sem precisar colar o JID inteiro nem estar dentro do grupo.
// Populado/atualizado pelo comando $grupos.
model CommunityGroup {
    shortId   Int      @id @default(autoincrement())
    groupJid  String   @unique
    subject   String?
    updatedAt DateTime @updatedAt
}

model BannedUser {
    userJid     String   // user JID
    displayName String?  // nome público (notify) da pessoa no momento do ban, se disponível
    groupJid    String   // group where ban was issued (or "comunidade")
    banType     String   // PERMANENTE | TEMPORARIO | COMUNIDADE
    reason      String
    expiresAt   DateTime? // for TEMPORARIO — null = never expires
    bannedBy    String   // admin JID who issued the ban
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@id([userJid, groupJid])
    @@index([userJid])
    @@index([groupJid])
}

model Warning {
    id        String   @id @default(cuid())
    userJid   String
    groupJid  String
    reason    String
    issuedBy  String   // admin JID, ou "ai" quando aplicada pela moderação automática
    createdAt DateTime @default(now())

    @@index([userJid])
    @@index([groupJid])
}

// Qual admin é responsável por qual grupo (avisos de promoção, pendências como pedido de entrada)
model AdminResponsibility {
    adminJid   String
    groupJid   String
    assignedAt DateTime @default(now())

    @@id([adminJid, groupJid])
    @@index([groupJid])
}

model GroupDescriptionChange {
    id             String    @id @default(cuid())
    groupJid       String
    oldDescription String?
    newDescription String?
    proposedBy     String
    status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
    voteMessageId  String?   // key.id da mensagem de votação, pra casar com as reações
    voteGroupJid   String?   // grupo onde a votação foi postada (grupo de admins)
    createdAt      DateTime  @default(now())
    resolvedAt     DateTime?

    @@index([groupJid])
    @@index([voteMessageId])
}

// Se uma proposta de mudança de descrição é rejeitada pela maioria, o grupo fica
// travado (o bot restaura a versão anterior) por um tempo.
model GroupDescriptionLock {
    groupJid          String   @id
    lockedUntil       DateTime
    frozenDescription String?  // descrição que o bot restaura se um admin tentar mudar durante a trava
}

// Quantas vezes essa pessoa já foi punida automaticamente por acúmulo de
// advertências nesse grupo — usado pra escalonar: 1ª = temporário 7 dias,
// 2ª = temporário 30 dias, 3ª+ = permanente (com aviso pros admins avaliarem
// se deve virar banimento de comunidade).
model WarningPunishmentHistory {
    userJid   String
    groupJid  String
    count     Int      @default(0)
    updatedAt DateTime @updatedAt

    @@id([userJid, groupJid])
}

// Resumo compacto (gerado pela própria IA) do que já foi observado num grupo,
// pra dar contexto na próxima checagem sem precisar reenviar o histórico
// inteiro de mensagens — só esse resumo pequeno + o delta novo. Cabe
// tranquilamente no mesmo SQLite que já usamos pra tudo, sem custo nenhum.
model GroupModerationMemory {
    groupJid  String   @id
    summary   String
    updatedAt DateTime @updatedAt
}

// Toda punição automática (moderação por IA, ou acúmulo de advertências)
// avisada no grupo de admins com opção de desfazer — por reação ❌ (sem
// motivo) ou por reply com texto (motivo registrado). Desfazer sempre
// remove o banimento e tenta readicionar a pessoa ao grupo.
model AutomatedPunishment {
    id         String    @id @default(cuid())
    userJid    String
    groupJid   String
    banType    String    // PERMANENTE | TEMPORARIO | COMUNIDADE
    reason     String
    source     String    // ia | advertencias
    messageId  String?   // key.id da notificação no grupo de admins
    status     String    @default("ACTIVE") // ACTIVE | REVERTED
    revertedBy String?
    revertReason String?
    createdAt  DateTime  @default(now())
    resolvedAt DateTime?

    @@index([messageId])
}
