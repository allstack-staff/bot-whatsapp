# Bot config
BOT_PREFIX=$
BOT_PARENT_COMMAND=asb
SESSION_PATH=./auth
LOG_LEVEL=info

# Database
DATABASE_URL="file:./prisma/dev.db"

# Admin group — obtained via $home command
# ADMIN_GROUP_JID=

# JID da WhatsApp Community "All Stack Community" — obrigatório. Toda ação em
# massa/automática do bot (regras, foto, ban comunidade, moderação por IA,
# votação de descrição) fica restrita a grupos vinculados a essa Community
# (meta.linkedParent). Sem isso, essas ações não fazem nada, por segurança.
# Descubra rodando o bot e checando os metadados de grupo, ou pergunte a quem já sabe.
COMMUNITY_JID=

# Moderação automática por IA (opcional — sem a chave, o ciclo horário só não faz nada)
# Gere de graça em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Publicação automática de regras aprovadas via $asb propor (opcional — sem o
# token, a proposta ainda é votada, só a publicação em docs/regras.md precisa
# ser feita manualmente). Fine-grained personal access token do GitHub,
# escopo só no repositório allstack-staff/bot-whatsapp, permissão "Contents:
# Read and write" — nada além disso.
GITHUB_RULES_TOKEN=
